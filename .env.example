# Copy to .env or .env.local; these settings are used only by the backend.
# Active backend environment: development or production. Defaults to development.
APP_ENV=development
# Development bucket, AWS region, and optional object key prefix.
S3_DEV_BUCKET=
S3_DEV_REGION=
S3_DEV_PREFIX=videos
# Separate production bucket, AWS region, and optional object key prefix.
S3_PROD_BUCKET=
S3_PROD_REGION=
S3_PROD_PREFIX=videos
# AWS credentials; leave empty when using an IAM role or local AWS profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credential session token.
AWS_SESSION_TOKEN=

# Development PostgreSQL connection used when APP_ENV=development.
DATABASE_DEV_URL=postgresql://yoink_dev_runtime:change-me@localhost:5432/yoink_development
# Production uses Amazon RDS for PostgreSQL with a separate runtime login.
# Example: postgresql://yoink_prod_runtime:PASSWORD@DB.REGION.rds.amazonaws.com:5432/yoink_production?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
DATABASE_PROD_URL=
# Administrator URLs used only by Alembic; use the same host and database as above.
DATABASE_DEV_ADMIN_URL=postgresql://yoink:yoink@localhost:5432/yoink_development
# RDS administrator connection to the same endpoint/database, with the same TLS options.
DATABASE_PROD_ADMIN_URL=

# Backend Sentry destination; leave empty to disable monitoring.
SENTRY_DSN=
# Optional deployment identifier; defaults to the installed backend version.
SENTRY_RELEASE=

# Enable batched backend and desktop log delivery using server-side AWS credentials.
CLOUDWATCH_ENABLED=false
# AWS region containing the log groups; required when enabled.
CLOUDWATCH_REGION=
# Log groups are <prefix>/<APP_ENV>/backend and /frontend; retention is 30 days.
CLOUDWATCH_LOG_GROUP_PREFIX=/yoink
